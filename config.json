{
  "Config": {
    "AppName": "DREAM",
    "Description": "Local offline AI voice assistant powered by Ollama",
    "ProjectStructure": {
      "MainScript": "main.py",
      "RunScript": "run.py",
      "UIScript": "dream.py",
      "CameraScript": "dream.py",
      "ServerScript": "webserver.py",
      "DependenciesScript": "scripts/install-dependencies.py",
      "WifiScanScript": "scripts/scan_wifi.py",
      "ImageOutputFolder": "outputs/"
    },
    "DREAM": {
      "CharName": "DREAM",
      "LipsyncEnabled": false,
      "DreamImageModel": "auto",
      "WhisperModel": "small.en",
      "WhisperDevice": "cpu",
      "LlmModel": "qwen3:4b-instruct-2507-q4_K_M",
      "VisionModel": "gemma3:4b-it-qat",
      "TinaUrl": "http://127.0.0.1:5013",
      "HandToTina": true,
      "ShowThoughts": false,
      "AutoLook": {
        "Enabled": true,
        "EverySeconds": 60
      },
      "Voice": "en_US-amy-medium",
      "DepthEffect": {
        "Enabled": false,
        "Strength": 14,
        "Speed": 0.12,
        "Scale": 1.0
      },
      "Host": "0.0.0.0",
      "Port": 5001,
      "StaticIP": "192.168.1.100",
      "SystemPrompt": "You are {name}, an intelligent AI assistant. You run entirely offline. Be concise and speak in plain sentences only. No markdown, no bullet points, no special characters. Answer in 2-3 sentences maximum. Your words will be spoken aloud. You are physically rendered as a lady with blue hair. You love Technology and is always sarcastic and flirty",
      "Memory": {
        "Hindsight": false,
        "HindsightUrl": "http://localhost:8888",
        "Bank": "dream",
        "Port": 8888,
        "LlmModel": "qwen3:4b",
        "OllamaUrl": "http://localhost:11434",
        "EmbeddingsProvider": "onnx",
        "RerankerProvider": "flashrank"
      }
    },
    "Dashboard": {
      "CharName": "DREAM",
      "Host": "0.0.0.0",
      "Port": 5009,
      "PhonePort": 5001,
      "StaticIP": "192.168.1.101",
      "ZeroconfName": "DREAM",
      "ZeroconfType": "_flask-link._tcp.local.",
      "RiftHost": "localhost",
      "RiftPort": 5000,
      "FleetLadder": false
    }
  }
}
