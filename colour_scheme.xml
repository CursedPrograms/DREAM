<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for DREAM, sampled from images/(no avatar).
  Avatar palette: blue and black (no avatar).
  Used by the GitHub Pages site (index.html) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#070A12"/>  <!-- window / page background -->
  <colour name="panel"            value="#0D1221"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#192543"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#121A30"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#E9ECF2"/>  <!-- primary text -->
  <colour name="text_sec"         value="#949BA8"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#575E6B"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#4C8DFF"/>  <!-- logo, links, selected / hover -->
  <colour name="accent_hover"     value="#89B4FF"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#4F73D9"/>  <!-- second avatar colour: highlights, tags -->
  <colour name="accent3"          value="#93C5FD"/>  <!-- third avatar colour -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#0E1625"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
